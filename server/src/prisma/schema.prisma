generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  STARTER
  PROFESSIONAL
  BUSINESS
}

model User {
  id                    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String     @unique
  password              String
  name                  String?
  plan        String     @default("STARTER") @map("plan")
  planExpires DateTime?  @db.Timestamp(6) @map("plan_expires")
  createdAt             DateTime?  @default(now()) @db.Timestamp(6)
  updatedAt             DateTime   @default(now()) @db.Timestamp(6) @map("updatedat")
  resetPasswordToken    String?    @map("resetpasswordtoken")
  resetPasswordExpire   DateTime?  @map("resetpasswordexpire")
  profileImage          String?    @map("profileimage")  
  profileImagePublicId  String?    @map("profileimagepublicid")  
  role                  Role       @default(USER)
  twoFactorEnabled      Boolean    @default(false) @map("twofactorenabled")
  twoFactorSecret       String?    @map("twofactorsecret")

  isVerified            Boolean    @default(false) @map("isverified")
  
  @@map("user")
}