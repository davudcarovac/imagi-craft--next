{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run postbuild",
    "postbuild": "tsc-alias && npm run create-dirs && npm run copy-assets",
    "create-dirs": "mkdir -p dist/models dist/outputs dist/outputsForZip dist/uploads dist/uploadsWm dist/zipOutput",
    "copy-assets": "cp -R src/models/* dist/models/ || true && ( [ -d src/outputs ] && cp -R src/outputs/* dist/outputs/ || true ) && ( [ -d src/outputsForZip ] && cp -R src/outputsForZip/* dist/outputsForZip/ || true ) && ( [ -d src/uploads ] && cp -R src/uploads/* dist/uploads/ || true ) && ( [ -d src/uploadsWm ] && cp -R src/uploadsWm/* dist/uploadsWm/ || true ) && ( [ -d src/zipOutput ] && cp -R src/zipOutput/* dist/zipOutput/ || true )",
    "start": "node dist/app.js",
    "dev": "nodemon src/app.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@tensorflow/tfjs-node": "^4.22.0",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "canvas": "^3.1.1",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "csurf": "^1.11.0",
    "dotenv": "^17.0.0",
    "exiftool-vendored": "^30.3.0",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "face-api.js": "^0.22.2",
    "file-type": "^21.0.0",
    "franc": "^6.2.0",
    "geoip-lite": "^1.4.10",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^8.5.1",
    "langs": "^2.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.4",
    "nodemon": "^3.1.9",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "speakeasy": "^2.0.0",
    "tesseract.js": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "zod": "^3.25.67"
  },
  "prisma": {
    "schema": "src/prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/tesseract.js": "^0.0.2",
    "copyfiles": "^2.4.1",
    "prisma": "^6.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
